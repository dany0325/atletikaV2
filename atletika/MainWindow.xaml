<Window x:Class="Atletika.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atlétikai verseny - Rajtszámok"
        Width="1440" Height="820"
        Background="#F3F6FA"
        FontFamily="Segoe UI" FontSize="14">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
            <TextBlock Text="Atlétikai verseny" FontSize="28" FontWeight="Bold" Foreground="#19324D"/>
            <TextBlock Text="Versenyzők regisztrációja és rajtszámok kiosztása" Foreground="#52657A"/>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,20,0" Padding="16"
                Background="White" BorderBrush="#D4DDE7" BorderThickness="1" CornerRadius="8">
            <DockPanel>
                <Button x:Name="btnRegisztral" DockPanel.Dock="Bottom" Content="REGISZTRÁL"
                        Height="36" Background="#DDEBFA" Margin="0,12,0,0"
                        Click="Regisztral_Click"/>

                <StackPanel>
                    <TextBlock Text="Új versenyző" FontSize="18" FontWeight="Bold"
                               Foreground="#19324D" Margin="0,0,0,12"/>

                    <TextBlock Text="Versenyző neve:" FontSize="12" Foreground="#52657A" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtNev" Height="32" Margin="0,0,0,10"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Left"/>

                    <TextBlock Text="Versenyszám:" FontSize="12" Foreground="#52657A" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbVersenyszam" Height="32" Margin="0,0,0,10"
                              IsEditable="False" SelectedIndex="-1" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="100 m"/>
                        <ComboBoxItem Content="200 m"/>
                        <ComboBoxItem Content="400 m"/>
                        <ComboBoxItem Content="800 m"/>
                        <ComboBoxItem Content="1500 m"/>
                        <ComboBoxItem Content="Távolugrás"/>
                        <ComboBoxItem Content="Magasugrás"/>
                        <ComboBoxItem Content="Súlylökés"/>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Nem:" FontSize="12" Foreground="#52657A"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <RadioButton x:Name="rbFerfi" GroupName="Nem" Content="Férfi" Margin="0,0,16,0"/>
                        <RadioButton x:Name="rbNo" GroupName="Nem" Content="Nő"/>
                    </StackPanel>

                    <Grid>
                        <TextBlock Text="Életkor:" FontSize="12" Foreground="#52657A"/>
                        <TextBlock x:Name="txtEletkor" Text="18 év" FontWeight="Bold"
                                   Foreground="#19324D" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="sldEletkor" Minimum="18" Maximum="90" Value="18"
                            TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                            ValueChanged="Eletkor_Valtozott"/>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="18" FontSize="11" Foreground="#52657A" HorizontalAlignment="Left"/>
                        <TextBlock Text="90" FontSize="11" Foreground="#52657A" HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock Text="Korábbi eredmények" FontWeight="Bold" Foreground="#19324D"
                               Margin="0,0,0,6"/>
                    <CheckBox x:Name="chkOlimpiai" Content="Olimpiai csúcs (OR)" Margin="0,0,0,4"/>
                    <CheckBox x:Name="chkVB" Content="Világcsúcs (VR)" Margin="0,0,0,4"/>
                    <CheckBox x:Name="chkEB" Content="Európa-csúcs (ER)" Margin="0,0,0,12"/>

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Igényelt rajtszám:" FontSize="12" Foreground="#52657A"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtRajtszam" Height="32" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="Üres mező: automatikus kiosztás." FontSize="11" Foreground="#52657A"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Padding="16"
                Background="White" BorderBrush="#D4DDE7" BorderThickness="1" CornerRadius="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Regisztrált versenyzők" FontSize="18"
                           FontWeight="Bold" Foreground="#19324D" Margin="0,0,0,8"/>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Eredményszűrő:" FontSize="12" Foreground="#52657A"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbRekordSzuro" Width="240" Height="32" IsEditable="False"
                              SelectedIndex="0" VerticalContentAlignment="Center"
                              SelectionChanged="Szuro_Valtozott">
                        <ComboBoxItem Content="Összes"/>
                        <ComboBoxItem Content="OR - olimpiai csúcs"/>
                        <ComboBoxItem Content="VR - világcsúcs"/>
                        <ComboBoxItem Content="ER - Európa-csúcs"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" FontSize="11" Foreground="#52657A" Margin="0,8,0,0"
                           Text="OR = olimpiai csúcs     VR = világcsúcs     ER = Európa-csúcs"/>

                <DataGrid x:Name="dgVersenyzok"
                          ItemsSource="{Binding Mode=OneWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          HeadersVisibility="Column"
                          SelectionUnit="FullRow"
                          SelectionMode="Single"
                          ColumnHeaderHeight="38"
                          RowHeight="32"
                          AlternationCount="2"
                          AlternatingRowBackground="#F4F7FB"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="#D4DDE7">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#19324D"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rajtszám" Binding="{Binding Rajtszam, Mode=OneWay}" Width="88"/>
                        <DataGridTextColumn Header="Név" Binding="{Binding Nev, Mode=OneWay}" Width="*"/>
                        <DataGridTextColumn Header="Versenyszám" Binding="{Binding Versenyszam, Mode=OneWay}" Width="160"/>
                        <DataGridTextColumn Header="Nem" Binding="{Binding Nem, Mode=OneWay}" Width="70"/>
                        <DataGridTextColumn Header="Életkor" Binding="{Binding Eletkor, Mode=OneWay}" Width="80"/>
                        <DataGridCheckBoxColumn Header="OR" Binding="{Binding OR, Mode=OneWay}" Width="80"/>
                        <DataGridCheckBoxColumn Header="VR" Binding="{Binding VR, Mode=OneWay}" Width="80"/>
                        <DataGridCheckBoxColumn Header="ER" Binding="{Binding ER, Mode=OneWay}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0" Padding="16"
                Background="White" BorderBrush="#D4DDE7" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtLetszam" Text="Látható: 0 / Összesen: 0"
                           Foreground="#52657A" VerticalAlignment="Center"/>
                <Button x:Name="btnMentes" Grid.Column="1" Content="FÁJLBA MENTÉS"
                        Width="210" Height="32" Click="Mentes_Click"/>
                <Button x:Name="btnBetoltes" Grid.Column="2" Content="FÁJLBÓL BETÖLTÉS"
                        Width="210" Height="32" Margin="16,0,0,0" Click="Betoltes_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
